# Data source for the service layer: "local" (IndexedDB mock backend) or "supabase".
VITE_DATA_SOURCE=local

# Public Supabase settings (only the anon key: it is safe to expose, RLS protects the data).
# Never put the service_role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TMDB "API Key" (v3) for the films and series of tastes. Public by design (read-only,
# it goes to the browser); without it the demo uses a sample catalogue.
VITE_TMDB_API_KEY=
